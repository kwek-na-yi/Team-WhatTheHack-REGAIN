*.sqlite
*.db
*.dump

# Logs, OS and editor clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local scratch scripts (e.g. one-off screenshot helpers)
scripts/_*
