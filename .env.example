# REGAIN environment variables — ALL OPTIONAL.
# The full demo works with none of these set: messages use deterministic templates and the
# Decision Copilot answers from REGAIN's own engine.
#
# To try the optional AI features locally: copy this file to `.env.local` (git-ignored), paste your
# own key there, and restart `npm run dev`. Never commit a real key.
#
# Used only on the server by /api/generate-message (message drafting) and /api/copilot
# (rewording Copilot answers). It is never sent to the browser. Leave empty to keep AI off —
# any non-empty value is treated as "AI configured".
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-haiku-5-5).
ANTHROPIC_MODEL=
